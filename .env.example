# 服务监听配置
PORT=3000
# 默认仅绑定 127.0.0.1（推荐配合 Nginx/Caddy 或 Cloudflare Tunnel）；如需直接对外监听改为 0.0.0.0
BIND_ADDR=127.0.0.1

# 首次启动自动初始化的管理员账号（仅在数据库尚无管理员时生效）
ADMIN_USERNAME=admin
# 建议显式设置强密码；若留空则首次启动时自动随机生成并打印在容器日志中
ADMIN_PASSWORD=

# 登录会话有效期（天）
SESSION_TTL_DAYS=30

# Cloudflare / 反向代理适配
# 部署在 Cloudflare 或 Nginx/Caddy 后方请保持 true，以正确识别真实用户 IP 与 HTTPS 协议
TRUST_PROXY=true
# auto：通过 HTTPS 或 Cloudflare 访问时自动开启 Secure Cookie，本地 HTTP 调试自动放行；
# 生产环境若确认全站走 HTTPS 也可强制设为 true
COOKIE_SECURE=auto

# 每日 SQLite 自动备份保留份数
BACKUP_KEEP_DAYS=14
ENABLE_AUTO_BACKUP=true

# 每年 11-12 月是否自动从开源数据源检查同步次年节假日
ENABLE_AUTO_HOLIDAY_SYNC=true
